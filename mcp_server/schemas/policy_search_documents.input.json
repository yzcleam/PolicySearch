{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicySearchDocumentsInput",
  "description": "政策文档检索工具的输入。query 为空时执行过滤/浏览查询，并按发布日期倒序返回。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "default": "",
      "description": "自然语言或关键词查询。空字符串表示不限制关键词，仅按 filters 浏览。示例：增值税留抵退税。"
    },
    "mode": {
      "type": "string",
      "enum": ["smart", "keyword", "exact", "fuzzy"],
      "default": "smart",
      "description": "检索模式。smart：短语+分词相关度+容错；keyword：BM25；exact：短语匹配；fuzzy：编辑距离容错。"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "精确匹配过滤条件。多个字段之间为 AND 关系。",
      "properties": {
        "issuers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 20,
          "default": [],
          "description": "发布机关，例如：国务院、国家税务总局。"
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 20,
          "default": [],
          "description": "政策类型，例如：税收优惠、科技创新。"
        },
        "regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 20,
          "default": [],
          "description": "适用地区，例如：全国、广东省、深圳市。"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 20,
          "default": [],
          "description": "主题标签，例如：减税降费、专精特新。"
        },
        "date_from": {
          "type": ["string", "null"],
          "format": "date",
          "default": null,
          "description": "发布日期下界，ISO 8601 日期，例如 2020-01-01。"
        },
        "date_to": {
          "type": ["string", "null"],
          "format": "date",
          "default": null,
          "description": "发布日期上界，ISO 8601 日期，例如 2024-12-31。"
        }
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "页码，从 1 开始。"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10,
      "description": "每页返回条数，最大 50。MCP 场景建议 3-10 以控制上下文。"
    },
    "sort": {
      "type": "string",
      "enum": ["relevance", "date_desc", "date_asc"],
      "default": "relevance",
      "description": "排序方式：相关度、发布日期倒序、发布日期正序。"
    },
    "slop": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 2,
      "description": "exact/smart 模式下短语允许的词间距。"
    }
  }
}
