# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# PostgreSQL (catalogue / source of truth)
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=policy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=policy_search
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER=policy-postgres
DATABASE_URL=postgresql+psycopg2://policy:change-me@127.0.0.1:5432/policy_search

# ---------------------------------------------------------------------------
# OpenSearch + IK (search copy)
# ---------------------------------------------------------------------------
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=policy_documents
OPENSEARCH_IMAGE=policysearcher/opensearch-ik:2.19.3
OPENSEARCH_BASE_IMAGE=opensearchproject/opensearch:2.19.3
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
OPENSEARCH_CONTAINER=policy-opensearch

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
SEED_COUNT=320
SEED_ON_DEPLOY=true
# PyPI mirror used by deploy for pip install; override for your network.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# auto | local | wsl
DOCKER_MODE=auto
WSL_DISTRO=Ubuntu
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# Authentication / JWT
# ---------------------------------------------------------------------------
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
# Generate with `npm run deploy`; leave blank for first deploy.
ADMIN_PASSWORD_HASH=
API_TOKEN_EXPIRE_DAYS=90
# false: search/document APIs stay public; admin endpoints always require JWT
AUTH_REQUIRED=false

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
# stdio for local clients, streamable-http for remote clients
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
MCP_STATELESS=false
MCP_LOG_LEVEL=INFO
MCP_AUTH_REQUIRED=true
MCP_AUTOSTART=true
# Optional service token for stdio MCP when AUTH_REQUIRED=true
POLICY_API_TOKEN=
POLICY_API_URL=http://127.0.0.1:8000
POLICY_API_TIMEOUT=15
